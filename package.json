{
  "name": "cenzontle",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm --filter @cenzontle/shared build && turbo dev --filter=@cenzontle/web --filter=@cenzontle/api",
    "dev:unsafe": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "dev:web": "pnpm --filter @cenzontle/shared build && turbo dev --filter=@cenzontle/web",
    "dev:api": "pnpm --filter @cenzontle/shared build && turbo dev --filter=@cenzontle/api",
    "clean": "turbo run clean && rm -rf .turbo apps/*/.turbo packages/*/.turbo node_modules/.cache/turbo"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9.15.0"
  }
}
