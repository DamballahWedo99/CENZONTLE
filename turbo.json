{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalPassThroughEnv": [
    "FORGE_PAUSED",
    "FORGE_EXECUTION_MODE",
    "FACTORY_WORKER_ALLOW_INSECURE",
    "FACTORY_WORKER_ALLOW_NO_SANDBOX",
    "FACTORY_WORKER_SANDBOX_MODE",
    "CLAUDE_BIN",
    "PUBLIC_API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
