{
  "name": "@cenzontle/worker",
  "version": "0.1.0",
  "private": true,
  "description": "CENZONTLE Factory Worker — connects a compute node to the dashboard, processes stories with Claude Code in headless mode.",
  "license": "Apache-2.0",
  "bin": {
    "factory-worker": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:secrets": "tsx src/verify-secret-read.ts",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@cenzontle/shared": "workspace:*",
    "commander": "^12.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0"
  },
  "devDependencies": {
    "@cenzontle/eslint-config": "workspace:*",
    "@cenzontle/ts-config": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7"
  }
}
