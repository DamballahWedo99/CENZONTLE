# ================================================================
# CENZONTLE Factory Worker — Environment Variables
# ================================================================
# READ THIS FIRST: the worker loads NO `.env` file. There is no dotenv
# dependency, `cli.ts` does not read one, and tsx does not auto-load one.
# Copying this file to `.env` does nothing.
#
# This file is documentation: it lists the runtime flags the worker reads from
# its own process environment. Export them in the shell that runs
# `factory-worker`, or set them in the service unit that supervises it:
#
#   FACTORY_WORKER_SANDBOX_MODE=firejail factory-worker start --slots 2
#
# One more trap: under `turbo dev`, a variable only reaches the child process
# if it is listed in `globalPassThroughEnv` in turbo.json. That list currently
# holds FORGE_PAUSED, FORGE_EXECUTION_MODE, FACTORY_WORKER_ALLOW_INSECURE,
# FACTORY_WORKER_ALLOW_NO_SANDBOX, FACTORY_WORKER_SANDBOX_MODE, CLAUDE_BIN and
# PUBLIC_API_URL. Anything else has to be set on the process directly.
#
# The connection itself (dashboardUrl, token, nodeId, slots) is NOT an env
# var: `factory-worker register` writes it to ~/.factory-worker/config.json.
#
# Full guide: docs/forge-worker.md · Reference: docs/configuration.md
# ================================================================

# --- Connection (normally set by `factory-worker register`, not here) ---
# Allows a dashboardUrl over http:// (do NOT use in production — secrets would
# travel in cleartext). Requires the exact value 1.
# FACTORY_WORKER_ALLOW_INSECURE=1

# --- Sandbox for running the AI-generated code ---
# Isolation mode. Valid values, EXACTLY these three:
#   sandbox-exec  → macOS (ships with the system)
#   firejail      → Linux (install it: sudo apt install firejail)
#   none          → no isolation
# Any other value is IGNORED silently and falls through to auto-detect (macOS →
# sandbox-exec, Linux with firejail → firejail, anything else → none).
# FACTORY_WORKER_SANDBOX_MODE=sandbox-exec
#
# Explicitly allows running WITHOUT a sandbox. This is a DOUBLE opt-in: the
# mode must resolve to `none` (by auto-detect or by forcing it above) AND this
# variable must be 1. Without it the worker aborts every run before spawning
# `claude` (the daemon still starts, but no story moves). Risky: with no
# sandbox, a prompt injection can read the host's ~/.ssh, ~/.aws and
# ~/.config/gh. Dev only.
# FACTORY_WORKER_ALLOW_NO_SANDBOX=1

# --- Claude Code CLI (the worker spawns `claude` headless) ---
# Path to the claude binary when it is not on PATH.
# CLAUDE_BIN=claude
# Model/effort override. The backend normally dictates both per story; these
# only apply when the claim carries nothing.
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_EFFORT=high
# Use the operator's OAuth session instead of an isolated API key.
# Requires the exact value 1.
# FACTORY_WORKER_USE_USER_SESSION=1
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Live terminal (ttyd + tmux) for watching the agent work ---
# TMUX_BIN=tmux
# TTYD_BIN=ttyd
# Public host or IP of the worker shown in the UI. Default: localhost.
# FACTORY_WORKER_PUBLIC_HOST=
