generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InitiativeStatus {
  planning
  active
  completed
  on_hold
}

enum EpicStatus {
  draft
  in_progress
  done
  blocked
}

enum Priority {
  critical
  high
  medium
  low
}

enum StoryStatus {
  backlog
  todo
  in_progress
  in_review
  qa
  done
  blocked
}

/// Estado de un nodo de cómputo en la flota del Forge. `online` = heartbeat
/// reciente; `offline` = sin heartbeat por > threshold (default 90s);
/// `degraded` = reachable pero reportando errores o slots reducidos.
enum ComputeNodeStatus {
  online
  offline
  degraded
}

/// Tipo de hardware del nodo. Solo metadata para UI/filtering — la lógica
/// de scheduling no distingue hoy. Mes 3+ podemos hacer routing inteligente
/// (ej. workloads GPU-heavy → gpu_instance).
enum ComputeNodeType {
  local
  mac_mini
  cloud_vm
  gpu_instance
  other
}

model Initiative {
  id          String           @id @default(uuid())
  name        String
  description String
  status      InitiativeStatus @default(planning)
  // startDate y targetDate son opcionales para permitir crear iniciativas en
  // borrador/planning sin compromiso temporal todavía. El frontend las pide
  // cuando se transiciona el status fuera de 'planning'.
  startDate   DateTime?
  targetDate  DateTime?
  owner       String
  documents   Json             @default("[]")
  tracker     Json?            // TrackerReference apuntando al Linear Initiative (o futuros providers)

  // Último resumen ejecutivo generado (ExecutiveSummary de @cenzontle/shared).
  // Métricas deterministas + narrativa IA. Se sobreescribe en cada generación.
  executiveSummary Json?

  // Path to the markdown file in the vault (GitHub repo)
  vaultPath   String?

  epics       Epic[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("initiatives")
}

model Epic {
  id                        String     @id @default(uuid())
  title                     String
  // Markdown único reemplaza los 12 campos discretos del shape v1.
  // Estructura mínima dictada por el prompt al agente IA y por el placeholder
  // del editor humano (9 headings level-2: Descripción, Beneficios cualitativos,
  // Beneficios cuantitativos, Medición de beneficios, Alcance, Criterios de
  // aceptación, Mejoras tecnológicas, Canales y flujos impactados,
  // Dependencias de terceros). Migration drop fue destructiva (Opción B).
  markdown                  String     @default("")
  status                    EpicStatus @default(draft)
  priority                  Priority   @default(medium)
  startDate                 DateTime
  targetDate                DateTime

  documents                 Json       @default("[]")
  diagrams                  Json       @default("[]")
  dependencies              Json       @default("[]")
  designs                   Json       @default("[]")
  designSkipped             Boolean    @default(false)
  poApproval                Json?
  tlApproval                Json?
  qaApproval                Json?
  qaMatrix                  Json?
  epicQAMatrix              Json?
  tracker                   Json?

  // Forge queue — set cuando el usuario hace click en "Subir al Forge" tras
  // los 3 VoBos. Modelo KISS para Mes 0 del roadmap; en Mes 1 migrará a
  // tabla `SprintBatch` con `EpicBatchRun` para wave planning + retries.
  enqueuedAt                DateTime?
  enqueuedBatchId           String?

  // Forge integration branch (Sprint 4): nombre de la rama temporal del
  // Forge donde mergean los PRs de las historias. Cortada de DEV cuando
  // se encola la épica. Formato: `${BranchStrategyConfig.forgeBranchPrefix}{epicId.slice(0,8)}`.
  // NULL hasta que la épica entra al Forge.
  forgeBranch               String?
  forgeBranchCreatedAt      DateTime?
  // SHA del DEV branch al momento de crear la integration branch — útil
  // para detectar drift y para diagnostics si el merge consolidado falla.
  forgeBranchBaseSha        String?
  // Número del PR consolidado al DEV (set cuando se completa todo el batch).
  consolidatedPrNumber      Int?
  consolidatedPrCreatedAt   DateTime?
  consolidatedPrMergedAt    DateTime?
  // SHA del merge commit en DEV — persistido en el mismo CAS transaction que
  // `consolidatedPrMergedAt`. Permite al PreviewService recuperar el snapshot
  // del epic post-merge aunque la integration branch ya haya sido borrada por
  // el cleanup automático (defense-in-depth fallback ante branch deletion).
  consolidatedMergeSha      String?

  // Staging gate approval — set cuando un TechLead aprueba el merge del
  // consolidated PR a DEV, después del Forge done. Step-up auth requerida
  // (password via Auth0 + role check estricto: TechLead o AltaGerencia).
  // Cuando estos campos están set, getBatchDetail/listQueue derivan
  // `currentLayer: Staging` y el batch se mueve a la columna Staged del
  // Pipeline Board. ApprovedByName es snapshot del nombre al momento de
  // aprobar para que el changelog persista aunque el user se renombre.
  stagingApprovedAt         DateTime?
  stagingApprovedBy         String?
  stagingApprovedByName     String?

  // Path to the markdown file in the vault (GitHub repo)
  vaultPath                 String?

  initiativeId              String
  initiative                Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  pods                      EpicPod[]
  stories                   Story[]

  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  @@index([enqueuedAt])
  @@map("epics")
}

model Pod {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  color       String

  epics         EpicPod[]
  stories       Story[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pods")
}

model EpicPod {
  epicId String
  podId  String
  epic   Epic @relation(fields: [epicId], references: [id], onDelete: Cascade)
  pod    Pod  @relation(fields: [podId], references: [id], onDelete: Cascade)

  @@id([epicId, podId])
  @@map("epic_pods")
}

model Story {
  id             String      @id @default(uuid())
  title          String
  status         StoryStatus @default(backlog)
  storyPoints    Int         @default(0)

  epicId         String
  epic           Epic        @relation(fields: [epicId], references: [id], onDelete: Cascade)
  podId          String
  pod            Pod         @relation(fields: [podId], references: [id])
  sprintId       String?

  labels         String[]    @default([])
  tracker        Json?

  // Componentes del componentManifest del design bundle que esta historia
  // cubre. Emitido por el PO agent durante la generación cuando la épica
  // tiene un bundle con manifest. El coverage gate (GET /epics/:id/coverage-check)
  // verifica que cada componente del manifest aparezca en `componentsCovered`
  // de al menos UNA story de la épica antes de permitir enqueue al Forge.
  // Vacío para historias backend-only o stories de épicas sin bundle.
  componentsCovered String[]  @default([])

  // Path to the markdown file in the vault (GitHub repo)
  vaultPath      String?

  // clientId de la propuesta staging que originó esta historia (si vino de un
  // batch del agente IA). Null para historias creadas manualmente. Sirve como
  // ancla para resolver story-to-story deps cuyos edges referencian clientIds
  // del batch antes de conocer los storyId reales.
  sourceClientId String?

  // Forge claim — set cuando un nodo del Compute Fleet reclama esta historia
  // para procesarla con Claude Code. NULL = claimable por el próximo worker
  // que pase el check del DAG (todas sus deps hard en status='done').
  // El sweeper cron resetea a NULL cuando un AgentRun queda 'abandoned'.
  claimedAt      DateTime?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Story-to-story ordering dependencies (emitidas por el agente Tech Lead).
  // "blockedBy" = historias que me bloquean a mí; "blocks" = historias que yo bloqueo.
  blockedBy      StoryDependency[] @relation("BlockedStory")
  blocks         StoryDependency[] @relation("BlockerStory")

  // Dependencias técnicas (APIs, secrets, fixtures, etc.) ligadas a la historia.
  // Reemplazan el modelo viejo Epic.dependencies + DiscoveredDependency-en-vault.
  technicalDependencies StoryTechnicalDependency[]

  // Runs históricos del Forge sobre esta historia (incluye abandoned/failed
  // para auditoría). UNIQUE constraint en AgentRun(storyId, status) garantiza
  // que solo haya 1 run "claimed" o "running" simultáneamente.
  agentRuns      AgentRun[]

  @@index([epicId])
  @@index([podId])
  @@index([sprintId])
  @@index([sourceClientId])
  @@index([claimedAt])
  @@map("stories")
}

/// Arista del DAG de historias — B depende de A significa que A debe completarse
/// antes que B pueda arrancar (hard) o terminar (soft). Self-reference many-to-many
/// en la tabla `stories`.
///
/// CASCADE en ambas relaciones: borrar una historia quita sus edges a/desde ella
/// automáticamente, evitando deps huérfanas que romperían queries inversas.
model StoryDependency {
  id            String   @id @default(uuid())
  storyId       String   // historia bloqueada
  blockedById   String   // historia que bloquea
  hardness      String   // 'hard' | 'soft'
  reason        String   // 'api_contract' | 'migration_order' | 'shared_model' | 'sequential_logic' | 'other'
  description   String   @default("")
  createdAt     DateTime @default(now())

  story     Story @relation("BlockedStory", fields: [storyId], references: [id], onDelete: Cascade)
  blockedBy Story @relation("BlockerStory", fields: [blockedById], references: [id], onDelete: Cascade)

  @@unique([storyId, blockedById])
  @@index([storyId])
  @@index([blockedById])
  @@map("story_dependencies")
}

/// Dependencias técnicas a nivel historia: APIs, secrets, fixtures, servicios,
/// equipos, etc. Reemplaza el modelo legacy de Epic.dependencies (JSONB) y de
/// DiscoveredDependency persistida en vault. Cada dep pertenece a UNA story
/// específica (FK con CASCADE) — las épicas agregan vía roll-up read-only.
///
/// Categoría unificada coherente con la categorización del frontend
/// (EpicDependencies.tsx CATEGORY_CONFIG): secrets, apis, testing, services,
/// teams, knowledge, other.
///
/// `source` preserva trazabilidad del origen (manual del user vs descubierta
/// por agente IA durante generación de stories) sin separar tablas.
model StoryTechnicalDependency {
  id                String   @id @default(uuid())
  storyId           String
  story             Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  title             String
  description       String   @default("")
  category          String   // 'secrets' | 'apis' | 'testing' | 'services' | 'teams' | 'knowledge' | 'other'
  severity          String   @default("medium") // 'critical' | 'high' | 'medium' | 'low'
  source            String   @default("manual") // 'manual' | 'discovered'

  vendor             String?
  requiresCredential Boolean @default(false)
  linkedSecretId     String?
  isBlocking         Boolean @default(false)

  // Para deps tipo "external" manual: nombre del ente externo (vendor/team).
  targetExternalName String?
  // Para deps tipo "cross-team" o "technical" manual: referencia a otro epic.
  targetEpicId       String?

  status            String    @default("identified") // 'identified' | 'in_progress' | 'resolved' | 'blocked' | 'mitigated'
  owner             String    @default("")
  dueDate           DateTime?
  resolutionNotes   String    @default("")

  // Markdown extenso (heredado del .md del vault para deps discovered).
  mdContent         String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([storyId])
  @@index([category])
  @@map("story_technical_dependencies")
}

/// Configuración de un vault de GitHub respaldando el knowledge base de CENZONTLE.
/// Múltiples vaults pueden existir pero solo uno puede estar activo a la vez
/// (controlado en el service layer, no en DB).
///
/// El token de GitHub se guarda encriptado con AES-256-GCM. Los 3 campos
/// tokenCiphertext/tokenIv/tokenAuthTag son los outputs del cifrado y los 3 son
/// necesarios para desencriptar. Nunca se devuelven vía API — solo se usan
/// internamente en el VaultService para autenticar con GitHub.
model VaultConfig {
  id              String   @id @default(uuid())
  name            String   @unique
  owner           String
  repo            String
  branch          String   @default("main")

  // Token encriptado con AES-256-GCM (nunca plaintext)
  tokenCiphertext String
  tokenIv         String
  tokenAuthTag    String

  isActive        Boolean  @default(false)

  // Permisos por defecto por rol para las carpetas de este vault.
  // JSON con shape Record<UserRole, AccessLevel>. Si está vacío, usa los defaults globales.
  // Ej: {"product_owner":"editor","tech_lead":"editor","qa":"viewer"}
  roleDefaults    Json     @default("{}")

  // Células (pods) con acceso a este vault. Array vacío = sin restricción (todas).
  allowedPodIds   String[] @default([])

  // Clone lifecycle para la búsqueda con ripgrep (tools vault_glob/grep/read).
  // Todos nullable/default para backward compatibility con Vaults existentes.
  cloneStatus     VaultCloneStatus @default(pending)
  clonedAtPath    String?
  lastPulledAt    DateTime?
  lastSyncedSha   String?
  lastSyncError   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("vault_configs")
}

/// Estados del clone local del Vault en disco. Separado de CodeRepoCloneStatus
/// porque son dominios distintos aunque el shape sea idéntico — ver plan doc.
enum VaultCloneStatus {
  pending
  cloning
  ready
  error
  stale
}

enum CodeRepoCloneStatus {
  pending
  cloning
  ready
  error
  stale
}

model CodeRepository {
  id              String   @id @default(uuid())
  name            String   @unique
  owner           String
  repo            String
  branch          String   @default("main")

  // Token encriptado con el mismo esquema que VaultConfig (AES-256-GCM).
  // Reutiliza VAULT_ENCRYPTION_KEY vía CryptoService.
  tokenCiphertext String
  tokenIv         String
  tokenAuthTag    String

  // Solo un repo "activo" a la vez (análogo a VaultConfig.isActive).
  isActive        Boolean  @default(false)

  // Permite que el Forge ESCRIBA en este repo (clone + commit + push + PR).
  // Independiente de `isActive` que es solo READ (ripgrep/glob por agentes
  // que generan épicas/stories). Para que el Forge use este repo como
  // destino de su trabajo, hace falta toggle EXPLÍCITO — opt-in defensivo.
  // Si false: getCloneUrl() de GitHubService excluye este repo y el Forge
  // cae a sandbox mode (no abre PRs).
  forgeWritable   Boolean  @default(false)

  // Lifecycle del clone local en disco
  cloneStatus     CodeRepoCloneStatus @default(pending)
  clonedAtPath    String?
  lastPulledAt    DateTime?
  lastSyncedSha   String?
  lastSyncError   String?

  // Pods con acceso (array vacío = sin restricción, igual que VaultConfig).
  allowedPodIds   String[] @default([])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("code_repositories")
}

// Credenciales externas (API keys de terceros, merchant codes, OAuth secrets)
// que el backend necesita para integrar con proveedores externos. El valor se
// guarda encriptado con el mismo esquema que VaultConfig/CodeRepository
// (AES-256-GCM vía CryptoService, deriva key de VAULT_ENCRYPTION_KEY).
//
// Scope: global por organización. `name` único estilo env var
// (STRIPE_API_KEY, TWILIO_AUTH_TOKEN). Runtime consumption vía
// ExternalSecretsService.getByName() — nunca expuesto por HTTP ni persistido
// plaintext.
model ExternalSecret {
  id              String   @id @default(uuid())
  name            String   @unique   // e.g. "STRIPE_API_KEY"
  vendor          String?            // e.g. "Stripe"
  description     String?

  tokenCiphertext String
  tokenIv         String
  tokenAuthTag    String

  lastRotatedAt   DateTime @default(now())
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("external_secrets")
}

// Configuración persistente por proveedor de tracker (Linear, Jira). Singleton
// por `provider` a nivel de organización. La API key viaja cifrada con AES-256-GCM
// vía CryptoService (mismo esquema que ExternalSecret/VaultConfig). El campo
// `metadata` JSONB contiene `LinearConfig`/`JiraConfig` SIN la credencial.
model IntegrationConfig {
  id               String    @id @default(uuid())
  provider         String    @unique   // 'linear' | 'jira'

  apiKeyCiphertext String
  apiKeyIv         String
  apiKeyAuthTag    String
  // Mask precomputado al save — evita decrypt en GET hot path. Sin esto, cada
  // read decifra el plaintext en memoria solo para enmascararlo (CWE-316).
  apiKeyMasked     String?

  metadata         Json      // LinearConfig|JiraConfig sin apiKey/apiToken
  fieldMapping     Json      // IntegrationFieldMapping

  status           String    @default("disconnected")  // 'connected' | 'disconnected' | 'error'
  lastTestedAt     DateTime?
  lastSyncedAt     DateTime?
  lastError        String?

  createdBy        String?
  lastModifiedBy   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("integration_configs")
}

model ChangelogEntry {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  entityType  String   // initiative | epic | story
  entityId    String
  entityTitle String
  action      String   // created | updated | deleted | approved | rejected
  field       String?
  oldValue    String?
  newValue    String?
  changedById String?
  changedByName String?

  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("changelog_entries")
}

/// Singleton: configuración de colores de diagrama por grupo para toda la
/// organización. Sólo Alta Gerencia puede modificarlo. `groupColors` es un
/// objeto JSON con llaves `start | end | frontend | backend | data | infra |
/// external | decision | alt` → hex string (#rrggbb).
///
/// `textColors` es nullable por backward compat — filas antiguas sin este
/// campo se resuelven en el service con DEFAULT_DIAGRAM_TEXT_COLORS. Shape:
/// `{ title: string; description: string }` donde ambos son hex #rrggbb.
model DiagramThemeSettings {
  id          String   @id @default("singleton")
  groupColors Json
  textColors  Json?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@map("diagram_theme_settings")
}

/// Singleton: límites de tokens (extended thinking + max_tokens) por agente
/// IA. Permite ajustar en caliente sin redeploy cuando un agente requiere
/// más razonamiento o output. Todos los valores son INT > 0; el service
/// valida bounds razonables (thinking 1024–32K, max_tokens 4K–64K). El
/// max_tokens debe ser SIEMPRE > thinking_budget — el service lo enforce.
///
/// Cinco agentes activos: PO/TL/QA de stories, generador de épicas, y
/// agentes de diagramas (principal + integration doc — comparten config).
/// El layout pass NO se expone porque no usa thinking (es estructural).
model AgentTokenSettings {
  id String @id @default("singleton")

  // Stories — Product Owner agent
  // effort ∈ 'low' | 'medium' | 'high' (validado en service/DTO).
  // 'max' solo soportado en modelos Opus; agregar cuando se haga upgrade.
  storyPoEffort          String  @default("medium")
  storyPoMaxTokens       Int     @default(28000)
  storyPoThinkingEnabled Boolean @default(true)

  // Stories — Tech Lead agent
  storyTlEffort          String  @default("medium")
  storyTlMaxTokens       Int     @default(64000)
  storyTlThinkingEnabled Boolean @default(true)

  // Stories — QA agent
  storyQaEffort          String  @default("medium")
  storyQaMaxTokens       Int     @default(64000)
  storyQaThinkingEnabled Boolean @default(true)

  // Epics agent (max_tokens dinámico → este valor es el cap superior)
  epicEffort          String  @default("medium")
  epicMaxTokens       Int     @default(64000)
  epicThinkingEnabled Boolean @default(true)

  // Diagrams agents (principal + integration doc)
  // 64000 = max_tokens nativo de Sonnet 4. Antes 32000 — pero el agente del
  // diagrama gasta MUCHO budget en thinking validando estructura (ciclos,
  // layer assignments, edge labels), y se quedaba sin tokens antes de
  // estructurar el submit_diagram. Subir a 64000 lo alinea con epicMaxTokens.
  diagramEffort          String  @default("medium")
  diagramMaxTokens       Int     @default(64000)
  diagramThinkingEnabled Boolean @default(true)

  // Forge Worker — coder agent (Claude Code CLI). Configurable desde
  // /factory/settings → tab "Factory". Reemplaza el approach de env vars
  // (CLAUDE_MODEL, CLAUDE_EFFORT) que requería redeploy del worker.
  //
  // forgeWorkerModel: ID del modelo Anthropic. Validados en DTO contra
  //   FORGE_WORKER_MODELS (haiku-4-5 | sonnet-4-6 | opus-4-7).
  // forgeWorkerEffort: low | medium | high | xhigh | max. Para Sonnet/Opus
  //   con effort >= 'high' el CLI activa extended thinking automático.
  //   Para Haiku, todos los valores != 'low' son no-op (Haiku no soporta).
  forgeWorkerModel  String @default("claude-sonnet-4-6")
  forgeWorkerEffort String @default("high")

  // Max wall-clock duration que el worker espera al CLI antes de matarlo.
  // Default: 1800000ms (30 min). Reemplaza la constante hardcoded
  // MAX_RUN_DURATION_MS de runner.ts:145. Configurable desde
  // /factory/settings → tab "Factory". Stories con muchos componentes UI o
  // suites de tests grandes pueden necesitar 60-90 min — el default 30 min
  // se quedaba corto y mataba runs JUSTO antes del commit (observado en
  // run cb180125 — 11 componentes pixel-perfect, killed at 30min sin push).
  //
  // Min 5 min (300_000) — runs más cortos suelen indicar config rota.
  // Max 7200000ms (120 min / 2h) — más allá usualmente significa que la
  // story es demasiado grande y deberia dividirse, NO subir el timeout.
  forgeWorkerMaxRunDurationMs Int @default(1800000)

  // DoD Verifier — reviewer agent (Claude Code CLI con --output-format json).
  // Configurable desde la misma tab "Factory". Reemplaza env vars
  // (DOD_VERIFIER_MODEL, DOD_VERIFIER_EFFORT). Default Haiku 4.5 + low porque
  // el verifier hace checks atómicos (passed/failed) y no requiere extended
  // thinking. Subir a Sonnet para detectar bypass sycophantic del coder en
  // tasks complejas.
  dodVerifierModel  String @default("claude-haiku-4-5-20251001")
  dodVerifierEffort String @default("low")

  // DoD retry loop — máximo de intentos del enforcement loop del worker.
  // 1 = una sola pasada (default; el verificador es no-bloqueante, los
  // criterios sin cumplir quedan como warn). >1 activa los reintentos: ante
  // un error duro (crash / clone / push) el worker re-corre el run, y ante
  // criterios del DoD sin cumplir re-spawnea claude con un retry-prompt.
  // Con doom loop: 2 intentos seguidos estancados o con regresión cortan el
  // run y escalan a humano. Rango 1-3, configurable en el tab "Factory".
  dodMaxAttempts Int @default(1)

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("agent_token_settings")
}

/// Configuración singleton de identidad de marca (branding) de la organización.
///
/// Permite a cada cliente customizar el logo (sidebar expandido), imagotipo
/// (sidebar colapsado) y favicon de la pestaña del navegador. Cuando un
/// storageKey es null, el frontend cae al asset estático default de
/// CENZONTLE en `/public` (Logo.svg / Imagotipo.svg).
///
/// IMPORTANTE: la BD persiste SOLO la storage key opaca del archivo en
/// disco. Las URLs públicas (`logoUrl`, etc.) que ve el cliente se
/// construyen en runtime en `toPublic()` del service — combinando un path
/// configurable y el `updatedAt` como cache buster. Esto evita que un
/// cambio en el routing del frontend rompa registros históricos en BD.
///
/// El endpoint GET es PÚBLICO (sin auth) porque el layout raíz consume el
/// favicon en SSR antes de Auth0. PATCH/POST/DELETE requieren MANAGE_BRANDING.
model BrandingSettings {
  id String @id @default("singleton")

  /// Nombre legible de la organización. Se inyecta en <title> de la página
  /// y en aria-label del logo. Default "CENZONTLE" mantiene la identidad
  /// original cuando no se ha customizado nada todavía.
  companyName String @default("CENZONTLE")

  /// Storage key opaca dentro del bucket S3 (S3_BUCKET) con prefix
  /// `branding/`. null ⇒ no hay asset custom, frontend usa el fallback
  /// estático. El URL público se construye dinámicamente en el service
  /// desde esta key — la BD nunca persiste la URL literal para evitar
  /// acoplamiento con el routing del frontend o el bucket específico.
  logoStorageKey          String?
  logoCollapsedStorageKey String?
  faviconStorageKey       String?

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("branding_settings")
}

/// Nodo de cómputo registrado en la flota del Forge. Cada nodo es una
/// máquina externa (MacBook local, Mac Mini de oficina, futuras VMs) que
/// corre el binario `factory-worker` y se autoregistra al dashboard usando
/// un `WorkerToken` Bearer.
///
/// El campo `ip` es self-reported — NUNCA usar para autenticar (un atacante
/// podría spoofear). La auth real es el token Bearer en headers.
///
/// Soft delete via `retiredAt`: cuando un nodo se "elimina" desde la UI,
/// no destruimos los `agentRuns` históricos. Solo lo marcamos retired y
/// revocamos sus tokens.
model ComputeNode {
  id            String            @id @default(uuid())
  name          String
  type          ComputeNodeType   @default(mac_mini)
  os            String            @default("")
  location      String            @default("")
  ip            String            @default("")
  status        ComputeNodeStatus @default(offline)
  totalSlots    Int               @default(1)
  lastHeartbeat DateTime?
  retiredAt     DateTime?

  tokens        WorkerToken[]
  agentRuns     AgentRun[]

  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Hot path: SELECT WHERE status='online' AND retiredAt IS NULL — listing
  // de nodos vivos en el dashboard.
  @@index([status, retiredAt])
  // Hot path: cron sweeper que marca `offline` nodos sin heartbeat reciente.
  @@index([lastHeartbeat])
  @@map("compute_nodes")
}

/// Token de autenticación Bearer para que un worker se conecte al dashboard.
/// Plaintext format: `worker_<32 base32 chars>` — devuelto UNA SOLA VEZ al
/// crear (patrón Stripe sk_xxx). Después solo se conoce por `prefix` (8 chars
/// visibles) y `tokenHash` (SHA-256 hex del plaintext).
///
/// `revokedAt` permite revocación inmediata: el guard rechaza con 401 si está
/// set. `expiresAt` es opcional (null = persistente para Mes 0/1; Mes 2
/// agregaremos JIT tokens single-use).
///
/// `lastUsedAt` se actualiza en cada request autenticado del worker — útil
/// para detectar uso anómalo desde la UI.
model WorkerToken {
  id          String       @id @default(uuid())
  nodeId      String
  node        ComputeNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  // SHA-256 hex (64 chars) del plaintext. NUNCA guardamos plaintext.
  tokenHash   String       @unique
  // Primeros chars del plaintext después de "worker_" — para mostrar en UI.
  prefix      String
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?

  createdById String?
  createdAt   DateTime     @default(now())

  @@index([nodeId, revokedAt])
  @@map("worker_tokens")
}

/// Run de un agente Claude Code sobre UNA historia, ejecutado en UN nodo
/// del Compute Fleet. Granularidad story (no épica) permite paralelismo
/// cross-machine respetando el DAG `StoryDependency` (hard).
///
/// Lifecycle:
///   claimed   → Worker llamó claim-story, fila creada. Aún no spawneó claude.
///   running   → Worker reportó progress al menos 1 vez. lastProgressAt fresh.
///   completed → Exit 0 + PR creado (prNumber set).
///   failed    → Exit ≠ 0 (errorMessage explica por qué).
///   abandoned → Sweeper cron detectó lastProgressAt > 10min sin update.
///               Reseta story.claimedAt = NULL para que otro worker pueda re-claim.
///
/// `@@unique([storyId, status])` red de seguridad: garantiza que solo haya
/// 1 fila claimed/running por historia. Si la lógica del SQL atómico de
/// claim falla por algún bug, la DB rechaza el INSERT.
model AgentRun {
  id              String      @id @default(uuid())
  storyId         String
  story           Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  nodeId          String
  node            ComputeNode @relation(fields: [nodeId], references: [id])

  // Forensics: WorkerToken específico usado para reclamar este run.
  // Si un token se filtra y se revoca, este campo permite reconstruir
  // exactamente qué runs hizo. Sin onDelete porque queremos preservar el
  // audit trail aunque el token se borre del catálogo (por eso String? sin
  // FK Prisma). Se llena en claimStory desde request.workerNode.tokenId.
  claimedByTokenId String?

  status          String      @default("claimed") // claimed | running | completed | failed | abandoned
  branch          String                          // forge/sprint-batch-XX/story-YY
  // Heartbeat por run — distinto del nodo. Refrescado cada vez que el worker
  // reporta progress. El sweeper marca abandoned si > 10min sin update.
  lastProgressAt  DateTime    @default(now())
  // Output capturado del proceso claude (stdout/stderr trimmed). Limitado
  // por el caller a últimas N líneas para no inflar el row con MB de logs.
  // SECURITY: el worker aplica regex de redacción antes de enviar (sk-ant-,
  // ghp_, AKIA, x-access-token) para evitar persistencia de secretos.
  lastOutput      String?
  // Si el run completa exitosamente Y el worker abrió un PR real, este
  // campo lleva el número. NULL no es sentinel de "no PR" — puede ser
  // pre-Sprint-3 (cuando el worker aún no implementa apertura de PRs).
  prNumber        Int?
  exitCode        Int?
  errorMessage    String?

  // Timeline de criterios/milestones del run. JSON array de
  // { id, label, status: 'pending'|'in_progress'|'completed'|'failed',
  //   source: 'worker'|'agent', startedAt?, completedAt? }.
  //
  // Combina:
  //  - Milestones automáticos del worker (workdir, clone, commit, push, PR)
  //    que son objetivos y verificables sin confiar en el agente
  //  - Criterios que el agente reporta vía /workspace/.cenzontle-criteria.json
  //    (opcional, para criterios específicos de la story)
  //
  // El AgentDetailDrawer consume este campo para mostrar progreso real.
  criteriaProgress Json?

  // URL del ttyd que el worker arranca contra la sesión tmux donde corre
  // claude. El frontend la abre en iframe para mostrar terminal interactiva
  // en vivo (igual que el AgentTerminal del agente mock). Null mientras
  // el run no haya iniciado ttyd, o si el worker corre en sandbox mode
  // sin terminal exposición. Formato: `http://host:port/`.
  ttydUrl         String?

  // Tier 1 harness — DoD enforcement loop.
  //
  // attempts: cuántas veces el worker re-spawneó claude para este run.
  // 1 es el primer intento (default). Cada vez que la verificación
  // determinística del DoD falla, el worker hace una pasada nueva con
  // retry-prompt incluyendo el output del fallo, hasta MAX_ATTEMPTS o
  // hasta que pase. Visible en UI para distinguir runs "limpios" vs
  // "que necesitaron correcciones".
  attempts        Int         @default(1)

  // dodVerification: log estructurado del veredicto por criterio en cada
  // attempt. Shape: array de objetos
  //   { attempt, criterion, kind, command, exitCode, output (truncated), passed }
  // El frontend lo consume para pintar timeline detallada de qué pasó/falló
  // en cada iteración del loop. Null antes del primer attempt verification.
  dodVerification Json?

  // plannerPlan: texto completo del plan generado por ForgePlannerService
  // (Sonnet executor + Opus advisor) ANTES del spawn CLI del coder. NULL si
  // el planner falló o no se invocó (degradación graciosa — el coder ejecutó
  // sin plan). Persistido para forensics: si una story falla, el operador
  // puede ver qué plan recibió y diagnosticar si el plan estaba mal o si el
  // coder lo ignoró.
  plannerPlan     String?

  // plannerUsage: breakdown cost/tokens del planner. Shape:
  //   { executorTokensIn/Out, advisorTokensIn/Out, advisorCalls,
  //     executorCostUsd, advisorCostUsd, totalCostUsd, elapsedMs }
  // Sumado a `totalCostUsd` del batch en `getBatchDetail` para que el
  // dashboard refleje cost real (planner + generator + verifier).
  plannerUsage    Json?

  // generatorUsage: cost/tokens del agente generator (claude -p con
  // --output-format stream-json) acumulado across DoD attempts. Shape:
  //   { callsCount, totalInputTokens, totalOutputTokens, totalCacheCreationInputTokens,
  //     totalCacheReadInputTokens, totalCostUsd, totalDurationMs, totalDurationApiMs,
  //     totalNumTurns, perAttempt: [{ attempt, ...usage }] }
  // Separado de dodVerification (que es del verifier Sonnet) porque son
  // modelos distintos con price tables independientes. `getBatchDetail` suma
  // ambos en `totalCostUsd` del batch.
  generatorUsage  Json?

  // filesModified: número de archivos únicos modificados en el diff entre el
  // baseBranch del epic y el head branch del worker tras el commit + push.
  // Calculado por el worker via `git diff --name-only origin/<base>..HEAD | wc -l`.
  // Visible en el AgentCard como "X files" para que el operador vea de un
  // vistazo el alcance del cambio sin tener que abrir el PR.
  filesModified   Int?

  // filesModifiedPaths: lista exacta de paths relativos modificados (mismo
  // diff que filesModified pero estructurado). Permite que el backend, al
  // materializar el claim de una story dependiente, inyecte en el prompt
  // del próximo agente los paths concretos producidos por stories del DAG
  // ya terminadas — el agente sabe qué archivos LEER antes de implementar
  // para respetar contratos previos en lugar de improvisar duplicados.
  // Cap defensivo: el worker trunca a 200 paths antes de enviar (defensa
  // contra runs masivos accidentales que inflarían el row). NULL para runs
  // legacy anteriores a la migration; los consumers degradan a `filesModified`
  // count cuando este array no está set.
  filesModifiedPaths String[]    @default([])

  startedAt       DateTime    @default(now())
  completedAt     DateTime?

  // Atomicidad del claim: solo 1 fila claimed/running por historia.
  //
  // IMPORTANTE: el constraint correcto es PARTIAL UNIQUE INDEX (solo
  // aplica a status IN ('claimed', 'running')). Prisma NO expresa partial
  // indexes en schema syntax — está creado manualmente con SQL raw:
  //
  //   CREATE UNIQUE INDEX agent_runs_story_active_unique
  //     ON agent_runs ("storyId", status)
  //     WHERE status IN ('claimed', 'running');
  //
  // Este index PERMITE múltiples runs terminales (completed/failed/
  // abandoned) por historia — necesario para retries y para el sweeper
  // que marca abandoned múltiples veces a lo largo del tiempo.
  //
  // Si haces `prisma db push` y el index desaparece, ejecuta el SQL de
  // arriba manualmente. Para detectarlo: el sweeper falla con error
  // "Unique constraint failed on (storyId, status)" cuando el índice
  // es full unique en lugar de partial.
  @@index([storyId, status])           // query helper para lookups por story
  @@index([nodeId, status])
  @@index([status, lastProgressAt])    // hot path: sweeper de abandoned
  @@index([claimedByTokenId])          // forensics: lookup por token leakeado
  @@map("agent_runs")
}

/// Singleton — UNA fila por organización (id='global' fixed). Almacena
/// la API key de Anthropic encriptada con AES-256-GCM (mismo CryptoService
/// que VaultConfig/CodeRepository/ExternalSecret).
///
/// El backend forwardea esta key al worker en el response de `claim-story`,
/// para que el worker la pase como ANTHROPIC_API_KEY env var al spawn de
/// `claude -p`. El worker NUNCA persiste la key a disco — solo en RAM
/// durante el run.
///
/// Solo Alta Gerencia puede leer/actualizar (admin endpoint dedicado).
/// Rotación: humano edita config, próximos claims usan la nueva key.
model OrgAnthropicConfig {
  id              String   @id @default("global")
  // Encriptado con AES-256-GCM via CryptoService. Plaintext NUNCA persiste.
  apiKeyCiphertext String?
  apiKeyIv         String?
  apiKeyAuthTag    String?
  // Últimos 4 chars del plaintext para mostrar en UI ("sk-...a3f8") sin
  // requerir decryptar. Generado al guardar.
  maskedKey       String?
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  @@map("org_anthropic_config")
}

/// Singleton — UNA fila por organización (id='global' fixed). Configura
/// el modelo de ramas que el Forge usa para crear branches y abrir PRs.
///
/// Modelo de 3 niveles (de la arquitectura v2 documentada):
///   main ← devBranch ← forge/sprint-batch-{epicId}
///
/// El Forge:
///  1. Por cada épica encolada, crea `${forgeBranchPrefix}{epicId}` cortada de devBranch
///  2. Cada historia genera PR contra esa integration branch
///  3. Reviewers automáticos (code + security) aprueban o piden cambios
///  4. Cuando todas las historias del batch están done, crea PR consolidado
///     `${forgeBranchPrefix}{epicId} → devBranch` para human gate (Staging)
///  5. Si autoDeleteForgeBranch=true, borra la branch tras el merge a DEV
///
/// Solo Alta Gerencia puede leer/actualizar.
model BranchStrategyConfig {
  id                    String   @id @default("global")
  devBranch             String   @default("dev")
  mainBranch            String   @default("main")
  forgeBranchPrefix     String   @default("forge/sprint-batch-")
  autoDeleteForgeBranch Boolean  @default(true)
  // Kill switch persistido en DB (no env var, que puede filtrarse por
  // turbo y no propagarse al backend). Cuando true, el endpoint
  // claim-story devuelve null inmediatamente sin importar el resto del
  // estado. Toggleable via UI sin reinicio del proceso.
  forgePaused           Boolean  @default(false)
  forgePausedAt         DateTime?
  forgePausedBy         String?
  forgePausedReason     String?
  updatedAt             DateTime @updatedAt
  updatedBy             String?

  @@map("branch_strategy_config")
}

/// Catálogo de criterios de Definition of Done que aplica a TODAS las stories
/// del Forge (lista global; no per-pod, no per-team). El operador edita esta
/// lista en `/factory/settings/Definition of Done` y los agentes la usan como
/// checklist al cerrar un run.
///
/// `kind` es un identificador estable (nullable) que el frontend usa para
/// mapear a lógica de evaluación determinística — ej. `code-written` →
/// run.exitCode === 0; `pr-created` → run.prNumber !== null. Custom criteria
/// que el operador agrega via UI tienen `kind = null` y solo se marcan como
/// hechos si el agente los reporta en `criteriaProgress` durante el run.
///
/// Solo Alta Gerencia puede leer/escribir esta tabla.
model DodCriterion {
  id        String   @id @default(uuid())
  /// Identificador estable para mapping determinístico. Nullable y único
  /// (Postgres permite múltiples NULLs en UNIQUE). Custom = null.
  kind      String?  @unique
  text      String
  /// Descripción larga (markdown-friendly). Se inyecta en el prompt del
  /// agente para que sepa exactamente qué se espera del criterio sin
  /// tener que adivinar desde el `text` corto. REQUERIDO — sin descripción
  /// el agente no tiene contexto suficiente, y el modelo de DoD pierde valor.
  description String
  /// Orden de display en la UI (drag&drop persiste aquí).
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dod_criteria")
}
