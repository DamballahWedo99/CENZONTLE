generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InitiativeStatus {
  planning
  active
  completed
  on_hold
}

enum EpicStatus {
  draft
  in_progress
  done
  blocked
}

enum Priority {
  critical
  high
  medium
  low
}

enum StoryStatus {
  backlog
  todo
  in_progress
  in_review
  qa
  done
  blocked
}

model Initiative {
  id          String           @id @default(uuid())
  name        String
  description String
  status      InitiativeStatus @default(planning)
  // startDate y targetDate son opcionales para permitir crear iniciativas en
  // borrador/planning sin compromiso temporal todavía. El frontend las pide
  // cuando se transiciona el status fuera de 'planning'.
  startDate   DateTime?
  targetDate  DateTime?
  owner       String
  documents   Json             @default("[]")
  tracker     Json?            // TrackerReference apuntando al Linear Initiative (o futuros providers)

  // Path to the markdown file in the vault (GitHub repo)
  vaultPath   String?

  epics       Epic[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("initiatives")
}

model Epic {
  id                        String     @id @default(uuid())
  title                     String
  // Markdown único reemplaza los 12 campos discretos del shape v1.
  // Estructura mínima dictada por el prompt al agente IA y por el placeholder
  // del editor humano (9 headings level-2: Descripción, Beneficios cualitativos,
  // Beneficios cuantitativos, Medición de beneficios, Alcance, Criterios de
  // aceptación, Mejoras tecnológicas, Canales y flujos impactados,
  // Dependencias de terceros). Migration drop fue destructiva (Opción B).
  markdown                  String     @default("")
  status                    EpicStatus @default(draft)
  priority                  Priority   @default(medium)
  startDate                 DateTime
  targetDate                DateTime

  documents                 Json       @default("[]")
  diagrams                  Json       @default("[]")
  dependencies              Json       @default("[]")
  designs                   Json       @default("[]")
  designSkipped             Boolean    @default(false)
  poApproval                Json?
  tlApproval                Json?
  qaApproval                Json?
  qaMatrix                  Json?
  epicQAMatrix              Json?
  tracker                   Json?

  // Path to the markdown file in the vault (GitHub repo)
  vaultPath                 String?

  initiativeId              String
  initiative                Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  pods                      EpicPod[]
  stories                   Story[]

  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  @@map("epics")
}

model Pod {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  color       String

  epics         EpicPod[]
  stories       Story[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pods")
}

model EpicPod {
  epicId String
  podId  String
  epic   Epic @relation(fields: [epicId], references: [id], onDelete: Cascade)
  pod    Pod  @relation(fields: [podId], references: [id], onDelete: Cascade)

  @@id([epicId, podId])
  @@map("epic_pods")
}

model Story {
  id             String      @id @default(uuid())
  title          String
  status         StoryStatus @default(backlog)
  storyPoints    Int         @default(0)

  epicId         String
  epic           Epic        @relation(fields: [epicId], references: [id], onDelete: Cascade)
  podId          String
  pod            Pod         @relation(fields: [podId], references: [id])
  sprintId       String?

  labels         String[]    @default([])
  tracker        Json?

  // Path to the markdown file in the vault (GitHub repo)
  vaultPath      String?

  // clientId de la propuesta staging que originó esta historia (si vino de un
  // batch del agente IA). Null para historias creadas manualmente. Sirve como
  // ancla para resolver story-to-story deps cuyos edges referencian clientIds
  // del batch antes de conocer los storyId reales.
  sourceClientId String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Story-to-story ordering dependencies (emitidas por el agente Tech Lead).
  // "blockedBy" = historias que me bloquean a mí; "blocks" = historias que yo bloqueo.
  blockedBy      StoryDependency[] @relation("BlockedStory")
  blocks         StoryDependency[] @relation("BlockerStory")

  // Dependencias técnicas (APIs, secrets, fixtures, etc.) ligadas a la historia.
  // Reemplazan el modelo viejo Epic.dependencies + DiscoveredDependency-en-vault.
  technicalDependencies StoryTechnicalDependency[]

  @@index([epicId])
  @@index([podId])
  @@index([sprintId])
  @@index([sourceClientId])
  @@map("stories")
}

/// Arista del DAG de historias — B depende de A significa que A debe completarse
/// antes que B pueda arrancar (hard) o terminar (soft). Self-reference many-to-many
/// en la tabla `stories`.
///
/// CASCADE en ambas relaciones: borrar una historia quita sus edges a/desde ella
/// automáticamente, evitando deps huérfanas que romperían queries inversas.
model StoryDependency {
  id            String   @id @default(uuid())
  storyId       String   // historia bloqueada
  blockedById   String   // historia que bloquea
  hardness      String   // 'hard' | 'soft'
  reason        String   // 'api_contract' | 'migration_order' | 'shared_model' | 'sequential_logic' | 'other'
  description   String   @default("")
  createdAt     DateTime @default(now())

  story     Story @relation("BlockedStory", fields: [storyId], references: [id], onDelete: Cascade)
  blockedBy Story @relation("BlockerStory", fields: [blockedById], references: [id], onDelete: Cascade)

  @@unique([storyId, blockedById])
  @@index([storyId])
  @@index([blockedById])
  @@map("story_dependencies")
}

/// Dependencias técnicas a nivel historia: APIs, secrets, fixtures, servicios,
/// equipos, etc. Reemplaza el modelo legacy de Epic.dependencies (JSONB) y de
/// DiscoveredDependency persistida en vault. Cada dep pertenece a UNA story
/// específica (FK con CASCADE) — las épicas agregan vía roll-up read-only.
///
/// Categoría unificada coherente con la categorización del frontend
/// (EpicDependencies.tsx CATEGORY_CONFIG): secrets, apis, testing, services,
/// teams, knowledge, other.
///
/// `source` preserva trazabilidad del origen (manual del user vs descubierta
/// por agente IA durante generación de stories) sin separar tablas.
model StoryTechnicalDependency {
  id                String   @id @default(uuid())
  storyId           String
  story             Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  title             String
  description       String   @default("")
  category          String   // 'secrets' | 'apis' | 'testing' | 'services' | 'teams' | 'knowledge' | 'other'
  severity          String   @default("medium") // 'critical' | 'high' | 'medium' | 'low'
  source            String   @default("manual") // 'manual' | 'discovered'

  vendor             String?
  requiresCredential Boolean @default(false)
  linkedSecretId     String?
  isBlocking         Boolean @default(false)

  // Para deps tipo "external" manual: nombre del ente externo (vendor/team).
  targetExternalName String?
  // Para deps tipo "cross-team" o "technical" manual: referencia a otro epic.
  targetEpicId       String?

  status            String    @default("identified") // 'identified' | 'in_progress' | 'resolved' | 'blocked' | 'mitigated'
  owner             String    @default("")
  dueDate           DateTime?
  resolutionNotes   String    @default("")

  // Markdown extenso (heredado del .md del vault para deps discovered).
  mdContent         String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([storyId])
  @@index([category])
  @@map("story_technical_dependencies")
}

/// Configuración de un vault de GitHub respaldando el knowledge base de CENZONTLE.
/// Múltiples vaults pueden existir pero solo uno puede estar activo a la vez
/// (controlado en el service layer, no en DB).
///
/// El token de GitHub se guarda encriptado con AES-256-GCM. Los 3 campos
/// tokenCiphertext/tokenIv/tokenAuthTag son los outputs del cifrado y los 3 son
/// necesarios para desencriptar. Nunca se devuelven vía API — solo se usan
/// internamente en el VaultService para autenticar con GitHub.
model VaultConfig {
  id              String   @id @default(uuid())
  name            String   @unique
  owner           String
  repo            String
  branch          String   @default("main")

  // Token encriptado con AES-256-GCM (nunca plaintext)
  tokenCiphertext String
  tokenIv         String
  tokenAuthTag    String

  isActive        Boolean  @default(false)

  // Permisos por defecto por rol para las carpetas de este vault.
  // JSON con shape Record<UserRole, AccessLevel>. Si está vacío, usa los defaults globales.
  // Ej: {"product_owner":"editor","tech_lead":"editor","qa":"viewer"}
  roleDefaults    Json     @default("{}")

  // Células (pods) con acceso a este vault. Array vacío = sin restricción (todas).
  allowedPodIds   String[] @default([])

  // Clone lifecycle para la búsqueda con ripgrep (tools vault_glob/grep/read).
  // Todos nullable/default para backward compatibility con Vaults existentes.
  cloneStatus     VaultCloneStatus @default(pending)
  clonedAtPath    String?
  lastPulledAt    DateTime?
  lastSyncedSha   String?
  lastSyncError   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("vault_configs")
}

/// Estados del clone local del Vault en disco. Separado de CodeRepoCloneStatus
/// porque son dominios distintos aunque el shape sea idéntico — ver plan doc.
enum VaultCloneStatus {
  pending
  cloning
  ready
  error
  stale
}

enum CodeRepoCloneStatus {
  pending
  cloning
  ready
  error
  stale
}

model CodeRepository {
  id              String   @id @default(uuid())
  name            String   @unique
  owner           String
  repo            String
  branch          String   @default("main")

  // Token encriptado con el mismo esquema que VaultConfig (AES-256-GCM).
  // Reutiliza VAULT_ENCRYPTION_KEY vía CryptoService.
  tokenCiphertext String
  tokenIv         String
  tokenAuthTag    String

  // Solo un repo "activo" a la vez (análogo a VaultConfig.isActive).
  isActive        Boolean  @default(false)

  // Lifecycle del clone local en disco
  cloneStatus     CodeRepoCloneStatus @default(pending)
  clonedAtPath    String?
  lastPulledAt    DateTime?
  lastSyncedSha   String?
  lastSyncError   String?

  // Pods con acceso (array vacío = sin restricción, igual que VaultConfig).
  allowedPodIds   String[] @default([])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("code_repositories")
}

// Credenciales externas (API keys de terceros, merchant codes, OAuth secrets)
// que el backend necesita para integrar con proveedores externos. El valor se
// guarda encriptado con el mismo esquema que VaultConfig/CodeRepository
// (AES-256-GCM vía CryptoService, deriva key de VAULT_ENCRYPTION_KEY).
//
// Scope: global por organización. `name` único estilo env var
// (STRIPE_API_KEY, TWILIO_AUTH_TOKEN). Runtime consumption vía
// ExternalSecretsService.getByName() — nunca expuesto por HTTP ni persistido
// plaintext.
model ExternalSecret {
  id              String   @id @default(uuid())
  name            String   @unique   // e.g. "STRIPE_API_KEY"
  vendor          String?            // e.g. "Stripe"
  description     String?

  tokenCiphertext String
  tokenIv         String
  tokenAuthTag    String

  lastRotatedAt   DateTime @default(now())
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("external_secrets")
}

// Configuración persistente por proveedor de tracker (Linear, Jira). Singleton
// por `provider` a nivel de organización. La API key viaja cifrada con AES-256-GCM
// vía CryptoService (mismo esquema que ExternalSecret/VaultConfig). El campo
// `metadata` JSONB contiene `LinearConfig`/`JiraConfig` SIN la credencial.
model IntegrationConfig {
  id               String    @id @default(uuid())
  provider         String    @unique   // 'linear' | 'jira'

  apiKeyCiphertext String
  apiKeyIv         String
  apiKeyAuthTag    String
  // Mask precomputado al save — evita decrypt en GET hot path. Sin esto, cada
  // read decifra el plaintext en memoria solo para enmascararlo (CWE-316).
  apiKeyMasked     String?

  metadata         Json      // LinearConfig|JiraConfig sin apiKey/apiToken
  fieldMapping     Json      // IntegrationFieldMapping

  status           String    @default("disconnected")  // 'connected' | 'disconnected' | 'error'
  lastTestedAt     DateTime?
  lastSyncedAt     DateTime?
  lastError        String?

  createdBy        String?
  lastModifiedBy   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("integration_configs")
}

model ChangelogEntry {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  entityType  String   // initiative | epic | story
  entityId    String
  entityTitle String
  action      String   // created | updated | deleted | approved | rejected
  field       String?
  oldValue    String?
  newValue    String?
  changedById String?
  changedByName String?

  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("changelog_entries")
}

/// Singleton: configuración de colores de diagrama por grupo para toda la
/// organización. Sólo Alta Gerencia puede modificarlo. `groupColors` es un
/// objeto JSON con llaves `start | end | frontend | backend | data | infra |
/// external | decision | alt` → hex string (#rrggbb).
///
/// `textColors` es nullable por backward compat — filas antiguas sin este
/// campo se resuelven en el service con DEFAULT_DIAGRAM_TEXT_COLORS. Shape:
/// `{ title: string; description: string }` donde ambos son hex #rrggbb.
model DiagramThemeSettings {
  id          String   @id @default("singleton")
  groupColors Json
  textColors  Json?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@map("diagram_theme_settings")
}

/// Singleton: límites de tokens (extended thinking + max_tokens) por agente
/// IA. Permite ajustar en caliente sin redeploy cuando un agente requiere
/// más razonamiento o output. Todos los valores son INT > 0; el service
/// valida bounds razonables (thinking 1024–32K, max_tokens 4K–64K). El
/// max_tokens debe ser SIEMPRE > thinking_budget — el service lo enforce.
///
/// Cinco agentes activos: PO/TL/QA de stories, generador de épicas, y
/// agentes de diagramas (principal + integration doc — comparten config).
/// El layout pass NO se expone porque no usa thinking (es estructural).
model AgentTokenSettings {
  id String @id @default("singleton")

  // Stories — Product Owner agent
  // effort ∈ 'low' | 'medium' | 'high' (validado en service/DTO).
  // 'max' solo soportado en modelos Opus; agregar cuando se haga upgrade.
  storyPoEffort          String  @default("medium")
  storyPoMaxTokens       Int     @default(28000)
  storyPoThinkingEnabled Boolean @default(true)

  // Stories — Tech Lead agent
  storyTlEffort          String  @default("medium")
  storyTlMaxTokens       Int     @default(64000)
  storyTlThinkingEnabled Boolean @default(true)

  // Stories — QA agent
  storyQaEffort          String  @default("medium")
  storyQaMaxTokens       Int     @default(64000)
  storyQaThinkingEnabled Boolean @default(true)

  // Epics agent (max_tokens dinámico → este valor es el cap superior)
  epicEffort          String  @default("medium")
  epicMaxTokens       Int     @default(64000)
  epicThinkingEnabled Boolean @default(true)

  // Diagrams agents (principal + integration doc)
  // 64000 = max_tokens nativo de Sonnet 4. Antes 32000 — pero el agente del
  // diagrama gasta MUCHO budget en thinking validando estructura (ciclos,
  // layer assignments, edge labels), y se quedaba sin tokens antes de
  // estructurar el submit_diagram. Subir a 64000 lo alinea con epicMaxTokens.
  diagramEffort          String  @default("medium")
  diagramMaxTokens       Int     @default(64000)
  diagramThinkingEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("agent_token_settings")
}
