# ================================================================
# CENZONTLE API — Environment Variables
# ================================================================

PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# ================================================================
# Auth0 Configuration
# ================================================================
# 1. Create an Auth0 account at https://auth0.com
# 2. Create a new API in Auth0 Dashboard > Applications > APIs
#    - Name: Cenzontle API
#    - Identifier (Audience): https://api.cenzontle.app
# 3. Copy the values below:

# Auth0 tenant URL (MUST end with trailing slash)
AUTH0_ISSUER_URL=https://YOUR_TENANT.auth0.com/

# API Identifier from step 2
AUTH0_AUDIENCE=https://api.cenzontle.app

