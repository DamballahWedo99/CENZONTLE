# ================================================================
# CENZONTLE API — Environment Variables
# ================================================================

PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# ================================================================
# Auth0 Configuration
# ================================================================
# 1. Create an Auth0 account at https://auth0.com
# 2. Create a new API in Auth0 Dashboard > Applications > APIs
#    - Name: Cenzontle API
#    - Identifier (Audience): https://api.cenzontle.app
# 3. Copy the values below:

# Auth0 tenant URL (MUST end with trailing slash)
AUTH0_ISSUER_URL=https://YOUR_TENANT.auth0.com/

# API Identifier from step 2
AUTH0_AUDIENCE=https://api.cenzontle.app

# ================================================================
# Auth0 — Step-up Authentication (verify-password)
# ================================================================
# Necesario para confirmar la identidad del usuario antes de acciones
# sensibles (VoBo de épicas, futuros gates de release). Usa Resource
# Owner Password Grant (ROPC) contra el endpoint /oauth/token.
#
# Configuración en Auth0:
#   1. Crear una "Regular Web Application" (no la API).
#   2. En Settings > Advanced > Grant Types habilitar "Password".
#   3. En Tenant Settings > Default Directory poner el nombre de tu
#      Database Connection (ej. "Username-Password-Authentication").
#   4. Copiar Client ID y Client Secret aquí abajo.
#
# IMPORTANTE: ROPC sólo funciona con conexiones tipo Database. Para
# usuarios SSO/Social, /auth/verify-password retornará 401 con un
# mensaje genérico (Auth0 enmascara el caso por seguridad).
#
# Si estos no se configuran, /auth/verify-password retornará 503
# y el flujo de VoBo quedará deshabilitado.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

