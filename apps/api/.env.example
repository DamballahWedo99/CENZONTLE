# ================================================================
# Anthropic (Claude) — AI Epic Generation
# ================================================================
# Required for AI-powered epic generation via the agent.
# Get your key at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-api03-...

# ================================================================
# Redis — caches de propuestas IA + storage del rate limiter
# ================================================================
# En producción con MÚLTIPLES réplicas de la API, REDIS_HOST/PORT deben apuntar
# a un Redis compartido: el rate limiter (@nestjs/throttler) guarda sus
# contadores acá para que los caps sean globales y no por-réplica. Si Redis no
# está disponible, el throttle falla-abierto (no bloquea requests).
REDIS_HOST=localhost
REDIS_PORT=6379
# TTL (segundos) del cache de propuestas generadas por IA. 432000 = 5 días.
PROPOSAL_CACHE_TTL=432000
STORY_PROPOSAL_CACHE_TTL=432000
