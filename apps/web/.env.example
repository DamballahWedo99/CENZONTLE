# ================================================================
# CENZONTLE Web — Environment Variables
# ================================================================
# Copia este archivo a `.env.local` y rellena los valores. NO lo commitees.
# Referencia completa de variables: docs/configuration.md
# ================================================================

NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-only URL for the BFF proxy (never exposed to the client bundle)
API_INTERNAL_URL=http://localhost:3001

# Secreto compartido del BFF proxy — DEBE coincidir EXACTAMENTE con el
# INTERNAL_API_KEY de apps/api/.env. Genera uno con: openssl rand -hex 32
INTERNAL_API_KEY=

# Ruta absoluta del repo en el host del API — el TerminalService deriva el
# git repo desde aquí (git rev-parse --show-toplevel) para abrir el
# workspace de Claude Code (BranchWorkspacePanel). Sin esta variable, el
# botón "Abrir Claude Code" queda deshabilitado. Es una ruta del filesystem
# del servidor; en dev local apunta a tu clon del monorepo.
NEXT_PUBLIC_PROJECT_ROOT=/ruta/absoluta/a/tu/clon/de/CENZONTLE

# ================================================================
# Auth0 Configuration (SDK v4)
# ================================================================
# 1. Create a "Regular Web Application" in Auth0 Dashboard > Applications
#    - Name: Cenzontle Web
#
# 2. Configure in Auth0 Application Settings:
#    - Allowed Callback URLs: http://localhost:3000/auth/callback
#    - Allowed Logout URLs:   http://localhost:3000
#    - Allowed Web Origins:   http://localhost:3000
#
# 3. Copy values below from Auth0 Application Settings:

# Auth0 domain (without https://)
AUTH0_DOMAIN=YOUR_TENANT.auth0.com

# Application Client ID and Secret
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Random secret (min 32 chars): openssl rand -hex 32
AUTH0_SECRET=

# App base URL
APP_BASE_URL=http://localhost:3000

# API audience (must match API Identifier in Auth0 > APIs)
AUTH0_AUDIENCE=https://api.cenzontle.app

# OPCIONAL — Step-up auth (re-confirmar password antes de acciones sensibles
# como VoBo de épicas o el release gate). Mismos valores que en apps/api/.env.
# Si se dejan vacíos, el flujo de step-up queda deshabilitado (503).
# AUTH0_M2M_CLIENT_ID=
# AUTH0_M2M_CLIENT_SECRET=
