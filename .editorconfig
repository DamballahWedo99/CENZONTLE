# EditorConfig — https://editorconfig.org
# Reflects the style the repo already has; it does not change it.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# `quote_type` is not part of core EditorConfig and only some editors honor it,
# but it writes down the repo's dominant convention: ~93% of the TS/JS imports
# use single quotes.
[*.{ts,tsx,js,jsx,mjs,cjs}]
quote_type = single

[*.md]
# In Markdown, two trailing spaces are a hard line break: trimming them would
# change the rendered output. Prose is wrapped by hand (~80 columns), but tables
# and long links run past it, so no automatic reflow.
trim_trailing_whitespace = false
max_line_length = off
